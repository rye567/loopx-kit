{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "run_id",
    "requirement",
    "mode",
    "status",
    "current_stage",
    "risk_tags",
    "max_auto_repair",
    "worklist",
    "events",
    "stages"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1",
        "2"
      ]
    },
    "catalog_version": {
      "type": "string"
    },
    "policy_snapshot": {
      "type": "string"
    },
    "policy_snapshot_sha256": {
      "type": "string"
    },
    "source_baseline": {
      "type": "string"
    },
    "last_solution_review": {
      "type": "object"
    },
    "run_id": {
      "type": "string"
    },
    "requirement": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "LIGHT",
        "STANDARD",
        "FULL"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "PASS",
        "BLOCKED",
        "LOCAL_INCOMPLETE_CI_REQUIRED"
      ]
    },
    "current_stage": {
      "type": "string"
    },
    "next_action": {
      "type": "string"
    },
    "active_agent": {
      "type": "string"
    },
    "stage_owners": {
      "type": "object"
    },
    "risk_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "automation_policy": {
      "type": "object",
      "required": ["mode", "authorized_by", "authorized_at"],
      "properties": {
        "mode": {"type": "string", "enum": ["gated", "auto_until_blocked"]},
        "authorized_by": {"type": "string"},
        "authorized_at": {"type": "string"}
      }
    },
    "max_auto_repair": {
      "type": "integer"
    },
    "worklist": {
      "type": "string"
    },
    "events": {
      "type": "string"
    },
    "repair_tickets": {
      "type": "string"
    },
    "loop_attempts": {
      "type": "object"
    },
    "interview": {
      "type": "object"
    },
    "spec": {
      "type": "object"
    },
    "mode_decision": {
      "type": "object"
    },
    "tracking": {
      "type": "object"
    },
    "git_gate": {
      "type": "object"
    },
    "compound_capture": {
      "type": "object"
    },
    "health": {
      "type": "object"
    },
    "stages": {
      "type": "object"
    },
    "stage_timing": {
      "type": "object"
    }
  }
}
